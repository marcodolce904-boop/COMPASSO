{
  "name": "compasso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -F @compasso/ui -F harness -F illustrator typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "tsx scripts/bench.ts",
    "bench:trace": "tsx scripts/bench-trace.ts",
    "fixtures:gen": "tsx scripts/gen-fixtures.ts",
    "fixtures:update": "tsx scripts/fixtures-update.ts",
    "dev": "pnpm -F harness dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
